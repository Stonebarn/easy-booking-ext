{
  "manifest_version": 3,
  "name": "Dialer Helper Pro",
  "version": "0.7.1",
  "description": "Auto-fills the booking form from the dialer and shows HubSpot contact, company, deal and activity context with call-note sync.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://*.nooks.in/*",
    "https://scheduler.default.com/*",
    "https://api.hubapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nooks.in/*"
      ],
      "js": [
        "content-nooks.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://scheduler.default.com/*"
      ],
      "js": [
        "content-scheduler.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Dialer Helper Pro",
    "default_icon": "icons/dialer_helper_icon.png"
  },
  "icons": {
    "16": "icons/dialer_helper_icon.png",
    "48": "icons/dialer_helper_icon.png",
    "128": "icons/dialer_helper_icon.png"
  }
}
